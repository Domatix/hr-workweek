<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="hours_worked_email_template" model="mail.template">
            <field name="name">Weekly report of worked hours</field>
            <field name="model_id" ref="model_hr_employee" />
            <field name="email_from">{{object.company_id.partner_id.email}}</field>
            <field name="subject">{{object.name}}'s weekly report of worked hours{{object.current_workweek and ': %s to %s' % (object.current_workweek.date_start, object.current_workweek.date_end) or ''}}</field>
            <field name="email_to">{{object.work_email}}</field>
            <field name="email_cc">{{object.coach_id.work_email}}</field>
            <field name="lang">{{object.user_id.partner_id.lang}}</field>
            <field name="body_html" type="html">
                <t t-set="workweek" t-value="object.current_workweek"/>
                <p>Hello <t t-out="object.name" />,</p>
                <t t-if="workweek">
                    <p>This week, from <t
                            t-out="workweek.date_start"/>
                        to <t t-out="workweek.date_end"/>,
                        you have worked <t
                            t-out="workweek.hours_worked" t-options="{'widget': 'float_time'}"/>
                        hours of
                        <t t-out="workweek.hours_to_work" t-options="{'widget': 'float_time'}"/>,
                        with <t t-out="workweek.unit_amount_invoiced" t-options="{'widget': 'float_time'}"/> invoiced hours
                        (<t t-out="round(workweek.work_efficiency, 2)"/>% efficiency).
                    </p>
                </t>
                <t t-else="">
                    <p>No current workweek has been generated for this employee yet.</p>
                </t>
                <p>Taking into account your past workweeks,
                    <t t-if="object.hours_difference &gt; 0">
                        <span
                            style="background-color: #ef9a9a"
                        > you still have to work <t
                                t-out="abs(object.hours_difference)" t-options="{'widget': 'float_time'}"/>
                            hours.</span>
                    </t>
                    <t t-elif="object.hours_difference &lt; 0">
                        <span style="background-color: #93c2e5"> you have <t
                                t-out="abs(object.hours_difference)" t-options="{'widget': 'float_time'}"/>
                            hours of overtime work.</span>
                    </t>
                    <t t-else="">
                        <span
                            style="background-color: #69f0ae"
                        > the difference between your worked and to work hours is <t
                                t-out="abs(object.hours_difference)" t-options="{'widget': 'float_time'}"/>
                            .</span>
                    </t>
                </p>
            </field>
        </record>

        <record id="hours_worked_summary_email_template" model="mail.template">
            <field name="name">Weekly summary report of worked hours</field>
            <field name="subject">Weekly summary report of worked hours</field>
            <field name="lang">{{object.user_id.partner_id.lang}}</field>
            <field name="model_id" ref="model_hr_employee" />
            <field name="body_html" type="html">
                <div>
                    <style>
                        table, th, td {
                            border: 1px solid #ddd;
                            padding: 8px;
                        }
                    </style>
                    <t t-set="calendars" t-value="ctx.get('calendars', [])"/>
                    <t t-foreach="calendars" t-as="calendar">
                        <t t-set="employees" t-value="ctx.get('employees_by_calendar', {}).get(calendar.id, [])"/>
                        <h2 style="padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: white; color: #8595bf;">
                            <t t-out="calendar.name"/>
                        </h2>
                        <table style="font-family: 'Trebuchet MS', Arial, Helvetica, sans-serif; border-collapse: collapse; width: 100%;">
                            <thead style="padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #8595bf; color: white;">
                                <tr style="text-align: left;">
                                    <th>Employee</th>
                                    <th>Hours worked</th>
                                    <th>Invoiced hours</th>
                                    <th>Efficiency</th>
                                    <th>Difference</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="employees" t-as="employee">
                                    <t t-set="workweek" t-value="employee.current_workweek"/>
                                    <t t-set="invoiced_hours" t-value="sum(workweek.account_analytic_line_ids.mapped('unit_amount_invoiced')) if workweek else 0.0"/>
                                    <t t-set="worked_hours" t-value="workweek.hours_worked if workweek else 0.0"/>
                                    <t t-set="efficiency" t-value="(invoiced_hours / worked_hours * 100) if worked_hours else 0.0"/>
                                    <tr style="text-align: left;">
                                        <td><span t-field="employee.name"/></td>
                                        <td>
                                            <span t-if="workweek" t-field="workweek.hours_worked" t-options="{'widget': 'float_time'}"/>
                                            <span t-else="">-</span>
                                        </td>
                                        <td>
                                            <span t-if="workweek" t-out="invoiced_hours" t-options="{'widget': 'float_time'}"/>
                                            <span t-else="">-</span>
                                        </td>
                                        <td t-att-style="'background-color: %s' % (
                                            '#ef9a9a' if efficiency &lt; 50 else
                                            '#ffff52' if efficiency &lt; 75 else '#69f0ae')">
                                            <t t-if="workweek">
                                                <span t-out="round(efficiency, 2)"/>%
                                            </t>
                                            <t t-else="">-</t>
                                        </td>
                                        <td t-att-style="'background-color: %s' % ('#ef9a9a' if workweek and workweek.hours_difference &gt; 0 else '#93c2e5' if workweek and workweek.hours_difference &lt; 0 else '#69f0ae')">
                                            <span t-if="workweek" t-field="workweek.hours_difference" t-options="{'widget': 'float_time'}"/>
                                            <span t-else="">-</span>
                                        </td>
                                        <td t-att-style="'background-color: %s' % ('#ef9a9a' if employee.hours_difference &gt; 0 else '#93c2e5' if employee.hours_difference &lt; 0 else '#69f0ae')">
                                            <span t-field="employee.hours_difference" t-options="{'widget': 'float_time'}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <h3 style="padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: white; color: #8595bf;">
                        Legend
                    </h3>
                    <table style="font-family: 'Trebuchet MS', Arial, Helvetica, sans-serif; border-collapse: collapse; width: 100%;">
                        <tbody>
                            <tr style="text-align: left;">
                                <th style="background-color: #ef9a9a">Low efficiency (&lt;50%)</th>
                                <th>Less than half of worked hours are invoiced</th>
                            </tr>
                            <tr style="text-align: left;">
                                <th style="background-color: #ffff52">Medium efficiency (50-75%)</th>
                                <th>Between 50-75% of worked hours are invoiced</th>
                            </tr>
                            <tr style="text-align: left;">
                                <th style="background-color: #69f0ae">High efficiency (&gt;75%)</th>
                                <th>More than 75% of worked hours are invoiced</th>
                            </tr>
                            <tr style="text-align: left;">
                                <th style="background-color: #ef9a9a">Due hours</th>
                                <th>The employee has worked less than they should've</th>
                            </tr>
                            <tr style="text-align: left;">
                                <th style="background-color: #93c2e5">Overtime hours</th>
                                <th>The employee has worked more than they should've</th>
                            </tr>
                            <tr style="text-align: left;">
                                <th style="background-color: #69f0ae">Cool hours</th>
                                <th>The employee has worked the exact amount they should've</th>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>
    </data>
</odoo>
