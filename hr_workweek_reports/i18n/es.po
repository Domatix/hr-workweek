#. module: hr_workweek_reports
#: model:mail.template,body_html:hr_workweek_reports.hours_worked_summary_email_template
msgid ""
"<div>\n"
"                    <style>\n"
"                        table, th, td {\n"
"                            border: 1px solid #ddd;\n"
"                            padding: 8px;\n"
"                        }\n"
"                    </style>\n"
"                    <t t-set=\"calendars\" t-value=\"ctx.get('calendars')\"></t>\n"
"                    <t t-foreach=\"calendars\" t-as=\"calendar\">\n"
"                        <h2 style=\"padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: white; color: #8595bf;\">\n"
"                            <t t-out=\"calendar.name\"></t>\n"
"                        </h2>\n"
"                        <table style=\"font-family: 'Trebuchet MS', Arial, Helvetica, sans-serif; border-collapse: collapse; width: 100%;\">\n"
"                            <thead style=\"padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #8595bf; color: white;\">\n"
"                                <tr style=\"text-align: left;\">\n"
"                                    <th>Employee</th>\n"
"                                    <th>Hours worked</th>\n"
"                                    <th>Invoiced hours</th>\n"
"                                    <th>Efficiency</th>\n"
"                                    <th>Difference</th>\n"
"                                    <th>Total</th>\n"
"                                </tr>\n"
"                            </thead>\n"
"                            <tbody>\n"
"                                <t t-foreach=\"ctx.get('employees_by_calendar').get(calendar.id, [])\" t-as=\"employee\">\n"
"                                    <tr style=\"text-align: left;\">\n"
"                                        <td><span t-field=\"employee.name\"></span></td>\n"
"                                        <td><span t-field=\"employee.current_workweek.hours_worked\"></span></td>\n"
"                                        <td>\n"
"                                            <span t-out=\"sum(employee.current_workweek.account_analytic_line_ids.mapped('unit_amount_invoiced'))\"></span>\n"
"                                        </td>\n"
"                                        <td t-att-style=\"'background-color: %s' % (                                             '#ef9a9a' if ((sum(employee.current_workweek.account_analytic_line_ids.mapped('unit_amount_invoiced')) / employee.current_workweek.hours_worked * 100) if employee.current_workweek.hours_worked &gt; 0 else 0) &lt; 50 else                                             '#ffff52' if ((sum(employee.current_workweek.account_analytic_line_ids.mapped('unit_amount_invoiced')) / employee.current_workweek.hours_worked * 100) if employee.current_workweek.hours_worked &gt; 0 else 0) &lt; 75 else '#69f0ae')\">\n"
"                                            <span t-out=\"round((sum(employee.current_workweek.account_analytic_line_ids.mapped('unit_amount_invoiced')) / employee.current_workweek.hours_worked * 100) if employee.current_workweek.hours_worked &gt; 0 else 0, 2)\"></span>%\n"
"                                        </td>\n"
"                                        <td t-att-style=\"'background-color: %s' % ('#ef9a9a' if employee.current_workweek.hours_difference &gt; 0 else '#93c2e5' if employee.current_workweek.hours_difference &lt; 0 else '#69f0ae')\">\n"
"                                            <span t-field=\"employee.current_workweek.hours_difference\"></span>\n"
"                                        </td>\n"
"                                        <td t-att-style=\"'background-color: %s' % ('#ef9a9a' if employee.hours_difference &gt; 0 else '#93c2e5' if employee.hours_difference &lt; 0 else '#69f0ae')\">\n"
"                                            <span t-field=\"employee.hours_difference\"></span>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </t>\n"
"                            </tbody>\n"
"                        </table>\n"
"                    </t>\n"
"                    <h3 style=\"padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: white; color: #8595bf;\">\n"
"                        Legend\n"
"                    </h3>\n"
"                    <table style=\"font-family: 'Trebuchet MS', Arial, Helvetica, sans-serif; border-collapse: collapse; width: 100%;\">\n"
"                        <tbody>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #ef9a9a\">Low efficiency (&lt;50%)</th>\n"
"                                <th>Less than half of worked hours are invoiced</th>\n"
"                            </tr>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #ffff52\">Medium efficiency (50-75%)</th>\n"
"                                <th>Between 50-75% of worked hours are invoiced</th>\n"
"                            </tr>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #69f0ae\">High efficiency (&gt;75%)</th>\n"
"                                <th>More than 75% of worked hours are invoiced</th>\n"
"                            </tr>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #ef9a9a\">Due hours</th>\n"
"                                <th>The employee has worked less than they should've</th>\n"
"                            </tr>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #69f0ae\">Overtime hours</th>\n"
"                                <th>The employee has worked more than they should've</th>\n"
"                            </tr>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #93c2e5\">Cool hours</th>\n"
"                                <th>The employee has worked the exact amount they should've</th>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <style>\n"
"                        table, th, td {\n"
"                            border: 1px solid #ddd;\n"
"                            padding: 8px;\n"
"                        }\n"
"                    </style>\n"
"                    <t t-set=\"calendars\" t-value=\"ctx.get('calendars')\"></t>\n"
"                    <t t-foreach=\"calendars\" t-as=\"calendar\">\n"
"                        <h2 style=\"padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: white; color: #8595bf;\">\n"
"                            <t t-out=\"calendar.name\"></t>\n"
"                        </h2>\n"
"                        <table style=\"font-family: 'Trebuchet MS', Arial, Helvetica, sans-serif; border-collapse: collapse; width: 100%;\">\n"
"                            <thead style=\"padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #8595bf; color: white;\">\n"
"                                <tr style=\"text-align: left;\">\n"
"                                    <th>Empleado</th>\n"
"                                    <th>Horas trabajadas</th>\n"
"                                    <th>Horas facturadas</th>\n"
"                                    <th>Eficiencia</th>\n"
"                                    <th>Diferencia</th>\n"
"                                    <th>Total</th>\n"
"                                </tr>\n"
"                            </thead>\n"
"                            <tbody>\n"
"                                <t t-foreach=\"ctx.get('employees_by_calendar').get(calendar.id, [])\" t-as=\"employee\">\n"
