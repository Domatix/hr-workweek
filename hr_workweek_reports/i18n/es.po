"                                        <td>\n"
"                                            <span t-out=\"sum(employee.current_workweek.account_analytic_line_ids.mapped('unit_amount_invoiced'))\"></span>\n"
"                                        </td>\n"
"                                        <td t-att-style=\"'background-color: %s' % (                                             '#ef9a9a' if ((sum(employee.current_workweek.account_analytic_line_ids.mapped('unit_amount_invoiced')) / employee.current_workweek.hours_worked * 100) if employee.current_workweek.hours_worked &gt; 0 else 0) &lt; 50 else                                             '#ffff52' if ((sum(employee.current_workweek.account_analytic_line_ids.mapped('unit_amount_invoiced')) / employee.current_workweek.hours_worked * 100) if employee.current_workweek.hours_worked &gt; 0 else 0) &lt; 75 else '#69f0ae')\">\n"
"                                            <span t-out=\"round((sum(employee.current_workweek.account_analytic_line_ids.mapped('unit_amount_invoiced')) / employee.current_workweek.hours_worked * 100) if employee.current_workweek.hours_worked &gt; 0 else 0, 2)\"></span>%\n"
"                                        </td>\n"
"                                        <td t-att-style=\"'background-color: %s' % ('#ef9a9a' if employee.current_workweek.hours_difference &gt; 0 else '#93c2e5' if employee.current_workweek.hours_difference &lt; 0 else '#69f0ae')\">\n"
"                                            <span t-field=\"employee.current_workweek.hours_difference\"></span>\n"
"                                        </td>\n"
"                                        <td t-att-style=\"'background-color: %s' % ('#ef9a9a' if employee.hours_difference &gt; 0 else '#93c2e5' if employee.hours_difference &lt; 0 else '#69f0ae')\">\n"
"                                            <span t-field=\"employee.hours_difference\"></span>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </t>\n"
"                            </tbody>\n"
"                        </table>\n"
"                    </t>\n"
"                    <h3 style=\"padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: white; color: #8595bf;\">\n"
"                        Legend\n"
"                    </h3>\n"
"                    <table style=\"font-family: 'Trebuchet MS', Arial, Helvetica, sans-serif; border-collapse: collapse; width: 100%;\">\n"
"                        <tbody>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #ef9a9a\">Eficiencia baja (&lt;50%)</th>\n"
"                                <th>Menos del 50% de las horas trabajadas se facturan</th>\n"
"                            </tr>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #ffff52\">Eficiencia media (50-75%)</th>\n"
"                                <th>Entre el 50-75% de las horas trabajadas se facturan</th>\n"
"                            </tr>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #69f0ae\">Eficiencia alta (&gt;75%)</th>\n"
"                                <th>Más del 75% de las horas trabajadas se facturan</th>\n"
"                            </tr>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #ef9a9a\">Horas debidas</th>\n"
"                                <th>El empleado ha trabajado menos de lo que debía</th>\n"
"                            </tr>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #69f0ae\">Horas extras</th>\n"
"                                <th>El empleado ha trabajado más de lo debido</th>\n"
"                            </tr>\n"
"                            <tr style=\"text-align: left;\">\n"
"                                <th style=\"background-color: #93c2e5\">Horas exactas</th>\n"
"                                <th>El empleado ha trabajado exactamente la cantidad que debía.</th>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </div>\n"
"            "

#. module: hr_workweek_reports
#: model:mail.template,body_html:hr_workweek_reports.hours_worked_email_template
msgid ""
"<p>Hello <t t-out=\"object.name\"></t>,</p>\n"
"                <p>This week, from <t t-out=\"object.current_workweek.date_start\"></t> to <t t-out=\"object.current_workweek.date_end\"></t>,\n"
"                    you have worked <t t-out=\"object.current_workweek.hours_worked\"></t> hours of\n"
"                    <t t-out=\"object.current_workweek.hours_to_work\"></t>,\n"
"                    with <t t-out=\"object.current_workweek.unit_amount_invoiced\"></t> invoiced hours\n"
"                    (<t t-out=\"round(object.current_workweek.work_efficiency, 2)\"></t>% efficiency).\n"
"                </p>\n"
"\n"
"                <p>Taking into account your past workweeks,\n"
"                    <t t-if=\"object.hours_difference &gt; 0\">\n"
"                        <span style=\"background-color: #ef9a9a\"> you still have to work <t t-out=\"abs(object.hours_difference)\"></t> hours.</span>\n"
"                    </t>\n"
"                    <t t-elif=\"object.hours_difference &lt; 0\">\n"
"                        <span style=\"background-color: #93c2e5\"> you have <t t-out=\"abs(object.hours_difference)\"></t> hours of overtime work.</span>\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <span style=\"background-color: #69f0ae\"> the difference between your worked and to work hours is <t t-out=\"abs(object.hours_difference)\"></t>.</span>\n"
"                    </t>\n"
"                </p>\n"
"            "
msgstr ""
"<p>Hola <t t-out=\"object.name\"></t>,</p>\n"
"                <p>Esta semana, desde <t t-out=\"object.current_workweek.date_start\"></t> hasta <t t-out=\"object.current_workweek.date_end\"></t>,\n"
"                    has trabajado <t t-out=\"object.current_workweek.hours_worked\"></t> horas de\n"
"                    <t t-out=\"object.current_workweek.hours_to_work\"></t>,\n"
"                    con <t t-out=\"object.current_workweek.unit_amount_invoiced\"></t> horas facturadas\n"
"                    (<t t-out=\"round(object.current_workweek.work_efficiency, 2)\"></t>% eficiencia).\n"
"                </p>\n"
"\n"
"                <p>Teniendo en cuenta tus pasadas semanas,\n"
"                    <t t-if=\"object.hours_difference &gt; 0\">\n"
"                        <span style=\"background-color: #ef9a9a\"> todavía tienes que trabajar <t t-out=\"abs(object.hours_difference)\"></t> horas.</span>\n"
"                    </t>\n"
"                    <t t-elif=\"object.hours_difference &lt; 0\">\n"
"                        <span style=\"background-color: #93c2e5\"> tienes <t t-out=\"abs(object.hours_difference)\"></t> horas extra.</span>\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <span style=\"background-color: #69f0ae\"> la diferencia entre tus horas trabajadas y a trabajar es de <t t-out=\"abs(object.hours_difference)\"></t>.</span>\n"
"                    </t>\n"
"                </p>\n"
"            "

