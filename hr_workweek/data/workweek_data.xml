<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="assignment_email_template" model="mail.template">
            <field name="name">Compensation assignment</field>
            <field name="model_id" ref="model_hr_compensation" />
            <field name="email_from">{{object.employee_id.user_id.company_id.partner_id.email}}</field>
            <field name="subject">Compensation assignment (Ref {{object.name or 'n/a'}})</field>
            <field name="partner_to">{{object.responsible_id.user_id.partner_id.id}}</field>
            <field name="email_cc">{{object.employee_id.work_email}}</field>
            <field name="auto_delete" eval="False" />
            <field name="lang">{{object.employee_id.user_id.partner_id.lang}}</field>
            <field name="body_html" type="html">
                <t t-set="button_access"
                   t-value="{
                       'url': object.get_base_url() + '/web#id=%s&amp;model=%s&amp;view_type=form' % (object.id, object._name),
                       'title': 'View compensation'
                   }"/>
                <t t-set="body_content">
                    <div style="margin: 15px 0;">
                        <p>Hello <t t-out="object.responsible_id.name"/>,</p>
                        <p> The compensation of <t t-out="object.name"/> has been assigned to you.</p>
                    </div>
                </t>
                <t t-set="has_button_access" t-value="True"/>
                <t t-set="company" t-value="object.env.company"/>
                <t t-set="message"
                    t-value="env['mail.message'].new({
                        'body': body_content,
                        'record_name': object.display_name,
                        'preview': '',
                        'model': object._name,
                        'res_id': object.id,
                    })"/>
                <t t-call="mail.mail_notification_layout">
                    <t t-set="object" t-value="object"/>
                    <t t-set="model_description" t-value="'Compensation'"/>
                </t>
            </field>
        </record>
    </data>
</odoo>
