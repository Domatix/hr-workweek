"                <p>\n"
"                    The compensation of<t t-out=\"object.employee_id.name\"></t> \n"
"                    <t t-out=\"object.name\"></t> has been assigned to you.\n"
"                </p>\n"
"                <t t-set=\"base_url\" t-value=\"object.env['ir.config_parameter'].sudo().get_param('web.base.url')\"></t>\n"
