"                    <a t-attf-href=\"{{ base_url }}/web?#id={{ object.id }}&amp;model=hr.compensation&amp;view_type=form\" style=\" background-color:#875A7B; padding:8px 16px; text-decoration:none; color:#fff; border-radius:5px; display:inline-block;\">\n"
"                        View Compensation\n"
"                    </a>\n"
"                </p>\n"
"            "
